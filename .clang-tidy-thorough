---
# TurboStar .clang-tidy-thorough configuration (Strict / Deep-Dive)
# Aimed at periodic audits, deep code reviews, and finding subtle edge cases.
# Includes const-correctness, cert guidelines, cppcoreguidelines, and extended checks.

Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-implicit-widening-of-multiplication-result,
  clang-analyzer-*,
  -clang-diagnostic-*,
  cert-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-pro-bounds-*,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-macro-usage,
  misc-*,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  performance-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-named-parameter,
  -readability-implicit-bool-conversion,
  -readability-function-cognitive-complexity,
  -readability-identifier-naming,
  -readability-braces-around-statements

WarningsAsErrors: ''
HeaderFilterRegex: 'src/.*'
FormatStyle: file
...
